APP_NAME=ftp2s3
APP_HOST_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ftp2s3
POSTGRES_DB=ftp2s3
POSTGRES_USER=ftp2s3
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-this-in-production
SESSION_COOKIE_NAME=ftp2s3_session
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
FTP_TIMEOUT=30
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
PANEL_MOUNT_PATH=/panel
PUBLIC_BASE_URL=http://localhost:8000
S3_SERVICE_NAME=s3
S3_DEFAULT_REGION=us-east-1
S3_ACCESS_KEY_ID=ftp2s3-access-key
S3_SECRET_ACCESS_KEY=ftp2s3-secret-key-change-me
S3_REQUIRE_SIGV4=true
S3_MAX_CLOCK_SKEW_SECONDS=900
S3_PRESIGN_EXPIRY_SECONDS=3600
